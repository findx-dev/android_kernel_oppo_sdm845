# Auto local version
CONFIG_LOCALVERSION_AUTO=y

# Crypto
CONFIG_CRYPTO_LZ4=y

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Face
CONFIG_OPPO_3D_FACE=y
CONFIG_OPPO_3D_FACE_QCOM=y

# Filesystems
CONFIG_EXFAT_FS=y

# Haptics
# CONFIG_INPUT_HBTP_INPUT is not set

# Motor
CONFIG_OPPO_MOTOR=y
CONFIG_MOTOR_CLASS_INTERFACE=y

# OPPO modules
CONFIG_OPPO_COMMON_SOFT=y
CONFIG_OPPO_DEVICE_INFO=y
CONFIG_OPLUS_FEATURE_PROJECTINFO=y
CONFIG_OPLUS_FEATURE_RECORD_MDMRST=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Ramdisk
CONFIG_RD_LZ4=y

# Touchscreen
CONFIG_TOUCHSCREEN_OPLUS=y
CONFIG_TOUCHIRQ_UPDATE_QOS=y
